# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 分配器：默认改用系统堆的标准 malloc/realloc/free。
# 内置 24KB 静态池在复杂圆角/蒙版绘制时会耗尽，lv_malloc 返回 NULL 后 LVGL 断言死循环，
# 饿死 IDLE 触发 TWDT 冻屏（真机已复现：圆角蒙版表分配失败）。系统堆约 130KB 可用，
# 不会占用额外静态区；仍可按需改回内置池并调 CONFIG_LV_MEM_SIZE_KILOBYTES。
CONFIG_LV_USE_CLIB_MALLOC=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth ---
# GPT Live 只用 Wi-Fi；关闭 BLE 以给 TLS、WebSocket 与音频缓冲留出内部 RAM。
CONFIG_BT_ENABLED=n

# --- TLS (wss://api.xsirouter.com) ---
# 使用 ESP-IDF 证书包校验服务器；动态缓冲在握手后释放不用的 TLS 内存（无 PSRAM）。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# 握手完成后释放 CA 与对端证书链：会话期间多出约 9 KB 空闲内存。
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# --- 音频 ---
# 会话中仍可能写 NVS（结束时保存音量），保持 I2S 中断在 Flash 操作期间可运行。
CONFIG_I2S_ISR_IRAM_SAFE=y

# --- 中文字体 ---
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
# 首次设置时屏幕显示热点二维码
CONFIG_LV_USE_QRCODE=y

# --- 内部 RAM 预算 ---
# 语音流只需约 100 kbps，不需要 Wi-Fi/LWIP 的 IRAM 加速；关闭后把 IRAM 让给堆
# （ESP32-C3 的 IRAM 与 DRAM 共用同一块 SRAM）。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

# --- TCP 窗口 ---
# 到 api.xsirouter.com 的往返约 250 ms，双向音频各约 43 KB/s（Base64 JSON）。默认 5760 字节
# 窗口每秒只能传约 23 KB，会话一开始上行就写超时断线；16 KB 窗口覆盖带宽时延积。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# --- 供电 ---
# 电池供电时 Wi-Fi 发射峰值可能触发欠压复位：复位后由 PHY 自动降低发射功率，避免开机反复重启。
CONFIG_ESP_PHY_REDUCE_TX_POWER=y

# --- 看门狗 ---
# 任何任务卡死（例如 LVGL 内存分配失败后的断言死循环）时触发 panic 并自动重启，而不是一直冻屏。
CONFIG_ESP_TASK_WDT_PANIC=y

# --- TCP 延迟 ACK ---
# 服务端连续发约 1.1 KB 的小消息并启用 Nagle：它要等设备 ACK 才发下一条。lwIP 默认 250 ms
# 的 TCP 定时器会把单独的 ACK 拖到 250 ms，下行只剩 2-5 条/秒。缩短到 50 ms。
CONFIG_LWIP_TCP_TMR_INTERVAL=50
# 跨洋链路白天有丢包：lwIP 默认不发 SACK、乱序缓存只有 4 个包，一丢包服务端就超时退避，
# 下行掉到 2-5 条/秒。开启 SACK，并把乱序缓存提到 8 个（IDF 建议范围内）。
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=8
